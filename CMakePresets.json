{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
    "configurePresets": [
        {
            "name": "clang-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
                "CMAKE_LINKER_TYPE": "LLD"
            }
        },
        {
            "name": "clang-release",
            "displayName": "clang++ + libc++ + lld (Release)",
            "inherits": "clang-base",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-relwithdebinfo",
            "displayName": "clang++ + libc++ + lld (RelWithDebInfo)",
            "inherits": "clang-base",
            "binaryDir": "${sourceDir}/build/relwithdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        { "name": "clang-release", "configurePreset": "clang-release" },
        { "name": "clang-relwithdebinfo", "configurePreset": "clang-relwithdebinfo" }
    ]
}
